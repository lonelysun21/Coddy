package main

import "fmt"

func main() {
	// Предопределенные переменные для сравнения
	num1 := 10
	num2 := 10
	name1 := "Go"
	name2 := "Python"
	
	// TODO: Сравните num1 и num2, используя оператор == (равенство)
	// и сохраните результат в numbersEqual
	numbersEqual := (num1 == num2) // Замените эту строку
	
	// TODO: Сравните name1 и name2, используя оператор != (неравенство)
	// и сохраните результат в namesNotEqual
	namesNotEqual := (name1 != name2) // Замените эту строку
	
	// Вывод результатов
	fmt.Println("Are the numbers equal?", numbersEqual)
	fmt.Println("Are the names different?", namesNotEqual)
}
